{
  "name": "camra-social-graphic-studio",
  "version": "2.4.0",
  "description": "An unofficial, browser-based studio for making on-brand CAMRA social graphics. Nothing is uploaded.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "author": "Sean O'Mahoney (https://seanomahoney.com)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json",
    "lint": "eslint .",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "docs": "node scripts/docs.mjs",
    "docs:check": "node scripts/docs.mjs --check",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run docs:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.58.2",
    "axe-core": "4.12.1",
    "esbuild": "0.27.2",
    "eslint": "9.35.0",
    "globals": "17.0.0",
    "typescript": "5.6.3"
  }
}
